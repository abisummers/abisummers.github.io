<style>
  .book {
    border: 0.1em solid currentColor;
    background: transparent;
    padding: 0.5em;
    margin: 1em;
    display: flex;
    justify-content: center;
  }
  .book .icon {
    display: none;
    height: 1em;
    width: 0.8em;
  }
  .book .placeholder {
    display: block;
  }
  @media screen and (max-width: 750px) {
    .book {
      display: flex;
      justify-content: center;
    }
    .book .icon {
      display: block;
    }
    .book .placeholder {
      display: none;
    }
  }
  @media screen and (max-width: 500px) {
    .book {
      margin: 0.25em;
    }
  }
</style>
