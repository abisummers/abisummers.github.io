---
import Article from "../../layouts/article.astro";
import { getProducts, type BookeoProduct } from "../../bookeo/api";

export async function getStaticPaths() {
  const { data, info } = await getProducts();

  if (!data) {
    throw new Error("No data found");
  }

  if (info.totalPages > 1) {
    throw new Error("Pagination not implemented");
  }

  return data.map((entry) => ({
    params: { slug: entry.productCode },
    props: { entry },
  }));
}

interface Props {
  entry: BookeoProduct;
}

const { entry } = Astro.props;
---

<Article showLanguageSwitcher={false} title={`Book: ${entry.name}`}>
  <noscript>Book a guided tour</noscript>
  <script
    type="text/javascript"
    src={`https://bookeo.com/widget.js?a=3252MKCWA4193B1401C92&type=${entry.productId}`}
    is:inline></script>
</Article>
