---
import { getCollection, type CollectionEntry } from 'astro:content';
import Main from '../../layouts/article.astro';

export async function getStaticPaths() {
  return (await getCollection('guide'))
    .map((entry) => ({
      params: { slug: entry.slug },
      props: { entry },
    }))
    .filter(
      (entry) => !entry.props.entry.data.draft && entry.props.entry.data.tourId
    );
}

interface Props {
  entry: CollectionEntry<'guide'>;
}

const { entry } = Astro.props;
---

<Main>
  <noscript>Book a guided tour</noscript>
  <script
    type="text/javascript"
    src={`https://bookeo.com/widget.js?a=3252MKCWA4193B1401C92&type=${entry.data.tourId}`}
  ></script>
</Main>
