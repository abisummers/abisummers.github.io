---
import Schema from "../../components/schema.astro";
import Article from "../../layouts/article.astro";
import { getProducts, type BookeoProduct } from "../../lib/bookeo";
import type { Service, TouristAttraction } from "schema-dts";
import type { MultiThing, WithMultiContext } from "../../lib/jsonld";
import { stripHtml } from "../../lib/html";

export const prerender = true;

export async function getStaticPaths() {
  const { data, info } = await getProducts();

  if (!data) {
    throw new Error("No data found");
  }

  if (info.totalPages > 1) {
    throw new Error("Pagination not implemented");
  }

  return data.map((entry) => ({
    params: { slug: entry.productCode },
    props: { entry },
  }));
}

interface Props {
  entry: BookeoProduct;
}

const { entry } = Astro.props;
---

<Article showLanguageSwitcher={false} title={`Book: ${entry.name}`}>
  <noscript>Book a guided tour</noscript>
  <script
    type="text/javascript"
    src={`https://bookeo.com/widget.js?a=3252MKCWA4193B1401C92&type=${entry.productId}`}
    is:inline></script>
</Article>

<Schema
  item={{
    "@context": "https://schema.org",
    "@type": ["Service", "TouristAttraction"],
    name: entry.name,
    description: await stripHtml(entry.description),
    url: `https://abisummers.com/book/${entry.productCode}`,
    provider: {
      "@type": "TravelAgency",
      name: "Abi Summers",
      areaServed: {
        "@type": "City",
        name: "Paris",
      },
      address: {
        "@type": "PostalAddress",
        addressLocality: "Paris",
        addressCountry: "FR",
      },
      priceRange: "€€",
    },
    offers: {
      "@type": "Offer",
      url: `https://abisummers.com/book/${entry.productCode}`,
      availability: "https://schema.org/InStock",
    },
  } as WithMultiContext<MultiThing<Service, TouristAttraction>>}
/>
