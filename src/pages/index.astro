---
import { type MarkdownInstance } from "astro";
import Main from "../layouts/main.astro";

const about = Object.values(
  import.meta.glob<MarkdownInstance<{ title: string; intro: string }>>(
    "./articles/about.md",
    { eager: true },
  ),
)[0];

const articles: Array<{
  title: string;
  intro: string;
  link?: string;
}> = [
  {
    title: about.frontmatter.title,
    intro: about.frontmatter.intro,
    link: "/articles/about/",
  },
  {
    title: "Guided through Paris",
    intro:
      "Advice from a local: from frequently asked questions to getting to know the city. I'm constantly updating this list, with new articles!",
    link: "/articles/guide/",
  },
  {
    title: "Book a tour",
    intro:
      "Looking for a private tour in Paris? I offer personalised tours, as well as themed tours.",
    link: "/book/",
  },
  {
    title: "The Alphabet of Île-de-France",
    intro:
      "A project to discover some of the less known locations within Île-de-France, one letter at a time.",
    link: "/articles/alphabet-ile-de-france/",
  },
  {
    title: "Museums",
    intro:
      "A place to share my thoughts after visiting a museum or exhibition.",
    link: "/articles/museums/",
  },
  {
    title: "Travel",
    intro: "A place to talk about all things travel.",
    link: "/articles/travel/",
  },
  {
    title: "Articles",
    intro:
      "Find all my articles here, from things to do in Paris, travelling within Île-de-France and travel blogs.",
    link: "/articles/",
  },
  {
    title: "Monthly wrap up",
    intro:
      "A review of each month, including thing I've seen in Paris, places I've visited and exhibitions I've been to.",
    link: "/articles/monthly-review/",
  },
];
---

<Main>
  <h1 class="logo font-riot">Abi Summers</h1>

  <section class="large" id="intro">
    <ul class="no-bullets">
      <li>tour guide</li>
      <li>software engineer</li>
      <li>slow traveller</li>
    </ul>
  </section>
  <div class="articles">
    {
      articles.map((article) => (
        <article>
          <h2>{article.title}</h2>
          <p>{article.intro}</p>
          {article.link && (
            <a class="cta" href={article.link}>
              read more
            </a>
          )}
        </article>
      ))
    }
  </div>
</Main>
