---
import Article from "../layouts/article.astro";
---

<Article title="Search">
  <div id="searchbox"></div>
  <div id="hits"></div>
  <div id="pagination"></div>

  <style is:global>
    .ais-SearchBox {
      margin: 1em 0;
    }
    .ais-SearchBox-input,
    .ais-SearchBox-submit,
    .ais-SearchBox-reset {
      appearance: none;
      -webkit-appearance: none;
      font: inherit;
      font-size: inherit;
      color: var(--text);
      border-radius: 0;
      border: 0.1em solid currentColor;
      background: var(--background);
    }

    .ais-SearchBox-form {
      display: flex;
      gap: 0.5em;
    }

    .ais-Hits-list {
      list-style-type: none;
      padding: 0;
    }

    mark {
      background-color: var(--contrast);
    }

    .side-by-side {
      display: grid;
      grid-template-columns: 1fr 5fr;
      gap: 0.5em;
    }

    .image {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .ais-Pagination-list {
      display: flex;
      list-style-type: none;
      flex-direction: row;
      gap: 0.5em;
    }
    .ais-Pagination-item--selected a {
      font-weight: bold;
      text-decoration: none;
    }
  </style>

  <script>
    import algoliasearch from "algoliasearch/lite";
    import instantsearch from "instantsearch.js";
    import { searchBox, hits, pagination } from "instantsearch.js/es/widgets";
    import { singleIndex } from "instantsearch.js/es/lib/stateMappings";

    instantsearch({
      indexName: "abisummers.com",
      searchClient: algoliasearch(
        "1AWHE68HXJ",
        "75243a82bfadb2efbd86cebf01addbff",
      ),
      routing: {
        stateMapping: singleIndex("abisummers.com"),
      },
    })
      .addWidgets([
        searchBox({
          container: "#searchbox",
          autofocus: true,
        }),
        hits({
          container: "#hits",
          templates: {
            item: (hit, { html, components }) => html`
              <article>
                <div>
                  <h3>
                    <a href="/${hit.pathname}"
                      >${components.Highlight({ attribute: "title", hit })}</a
                    >
                  </h3>
                  <p>
                    ${components.Snippet({
                      attribute: "content",
                      hit,
                      highlightedTagName({ children }) {
                        return html`<a
                          href="/${hit.pathname}#:~:text=${children}"
                          ><mark>${children}</mark></a
                        >`;
                      },
                    })}
                  </p>
                  <a class="cta" href="/${hit.pathname}">read more </a>
                </div>
              </article>
            `,
          },
        }),
        pagination({
          container: "#pagination",
        }),
      ])
      .start();
  </script>
</Article>
