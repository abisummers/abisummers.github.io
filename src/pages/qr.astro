---
import Main from "../layouts/article.astro";
---

<Main>
  <style>
    .links {
      display: flex;
      flex-direction: column;
      gap: 2em;
    }
    .button-link {
      appearance: none;
      -webkit-appearance: none;
      font: inherit;
      font-size: inherit;
      color: var(--text);
      border-radius: 0;
      padding: 0.5em;
      border: 0.1em solid currentColor;
      text-decoration: none;
      text-align: center;
    }
  </style>
  <div class="">
    <p>Welcome to the website of Abi Summers, tour guide in Paris.</p>
    <div class="links">
      <a href="/book/" class="button-link">Book a tour</a>
      <!-- <a href="/book/" class="button-link">Give me a review</a> -->
      <a href="/articles/guide/" class="button-link">Tips about Paris</a>
      <a
        href="https://www.google.com/maps/d/edit?mid=117w2uwIFA2aieW8BoL4KOY-7JlBs3_g&usp=sharing"
        target="_blank"
        class="button-link">My recommendations</a
      >
      <a
        href="https://www.instagram.com/abi.in.france/"
        target="_blank"
        class="button-link">Instagram</a
      >
      <a href="mailto:contact@abisummers.com" class="button-link">Contact me</a>
    </div>
  </div>
</Main>
