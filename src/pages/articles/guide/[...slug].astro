---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import Main from "../../../layouts/article.astro";
import MapboxMap from "../../../components/mapbox-map.astro";

export async function getStaticPaths() {
  return (await getCollection("guide"))
    .map((entry) => ({
      params: { slug: entry.slug },
      props: { entry },
    }))
    .filter((entry) => !entry.props.entry.data.draft);
}

interface Props {
  entry: CollectionEntry<"guide">;
}

const { entry } = Astro.props;

let ogImage: string | undefined;
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/images/*.{jpeg,jpg}",
);
if (images[entry.data.image]) {
  const { default: image } = await images[entry.data.image]();
  const { src } = await getImage({
    src: image,
    format: "jpeg",
  });
  ogImage = "https://abisummers.com" + src;
}

const { Content } = await entry.render();
---

<Main
  showLanguageSwitcher={false}
  title={entry.data.title}
  description={`Guided through Paris`}
  ogImage={ogImage}
>
  <h2>{entry.data.title}</h2>

  <style is:global>
    img {
      max-width: 100%;
      height: auto;
    }
  </style>
  <Content />
  <style>
    footer p {
      font-style: italic;
    }
    footer .links {
      display: flex;
      justify-content: space-between;
      gap: 0.5em;
    }

    footer .links a {
      padding: 2em;
      border: 0.1em solid currentColor;
      text-decoration: none;
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 1em;
    }

    footer .links a:hover {
      background-color: var(--contrast);
    }
    footer .links a .title {
      text-decoration: underline;
    }
  </style>

  {
    entry.data.locations ? (
      <MapboxMap
        latitude={entry.data?.mapConfig?.latitude || 48.86}
        longitude={entry.data?.mapConfig?.longitude || 2.35}
        zoom={entry.data?.mapConfig?.zoom || 10.6}
        mapstyle="mapbox://styles/haroenv/clvi5zbe601bg01qu2iez1exk"
        accesstoken="pk.eyJ1IjoiaGFyb2VudiIsImEiOiJjbHZpOGZsOHQwM3oyMmlscTJweTRleHo3In0.mU1wMXCVpQvbhkXcZvFawg"
        interactive="interactive"
        points={entry.data.locations.map((entry: any) => ({
          latitude: entry.latitude,
          longitude: entry.longitude,
          title: entry.title,
          location: entry.location,
          subtle: entry.subtle
        }))}
      />
    ) : (
      ""
    )
  }
  <hr />
  <footer>
    <p>
      This article is part of my <a href="/articles/guide/">guide</a> collection
      where I write about my tips and tricks for enjoying Paris as a tourist.
    </p>
    <p>
      If you're new here, hi, I'm Abi. Originally from the UK but I've been
      living in Paris since 2016. I'm a freelance tour guide, and love sharing
      my love of Paris, France and French culture both on my blog and on tours.
    </p>
    <p>
      If you have any queries about visting Paris, you can get in contact via
      email at <strong
        ><a href="mailto:contact@abisummers.com">contact@abisummers.com</a
        ></strong
      > or via instagram at <strong
        ><a href="https://www.instagram.com/abisummers/">@abisummers</a></strong
      >.
    </p>
  </footer>
</Main>
