---
import type { MarkdownInstance } from 'astro';
import Main from '../../../layouts/article.astro';

const unsorted = Object.values(
  import.meta.glob<MarkdownInstance<{ title: string; intro: string }>>(
    './*.{md,mdx,astro}',
    {
      eager: true,
    }
  )
);

const articles = [
  ...unsorted.map((article) => ({
    title: article.frontmatter.title,
    intro: article.frontmatter.intro,
    url: article.url,
  })),
];
---

<Main description="rechercher tous les articles">
  <h2>Articles</h2>
  {
    articles.map((article) => (
      <article>
        <h3>{article.title}</h3>
        <p>{article.intro}</p>
        {article.url && (
          <a class="cta" href={article.url}>
            lisez plus
          </a>
        )}
      </article>
    ))
  }
</Main>
