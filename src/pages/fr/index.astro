---
import { type MarkdownInstance } from "astro";
import Main from "../../layouts/main.astro";
import { Image } from "astro:assets";
import profilePicture from "../../content/articles/images/profile-picture.jpeg";

const about = Object.values(
  import.meta.glob<MarkdownInstance<{ title: string; intro: string }>>(
    "./articles/about.md",
    { eager: true },
  ),
)[0];

const articles: Array<{
  title: string;
  intro: string;
  link?: string;
}> = [
  {
    title: about.frontmatter.title,
    intro: about.frontmatter.intro,
    link: "/about/",
  },
];
---

<Main>
  <h1 class="logo font-riot">Abi Summers</h1>

  <section class="large" id="intro">
    <style>
      #intro {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 1em;
      }
      #intro img {
        border-radius: 0.5em;
        width: 200px;
        max-width: 28vw;
        height: auto;
      }
      #intro .no-bullets {
        display: flex;
        flex-direction: column;
        gap: 0.5em;
      }
    </style>
    <Image
      priority
      src={profilePicture}
      alt="a woman with short brown hair, she is smiling. She is wearing a red scarf and holding a cup in her hand"
      width={600}
    />
    <ul class="no-bullets">
      <li>guide touristique</li>
      <li>ingénieur logiciels</li>
      <li>slow traveller</li>
    </ul>
  </section>
  <div class="articles">
    {
      articles.map((article) => (
        <article>
          <h2>{article.title}</h2>
          <p>{article.intro}</p>
          {article.link && (
            <a class="cta" href={"/fr/articles" + article.link}>
              lisez plus
            </a>
          )}
        </article>
      ))
    }
  </div>
</Main>
